{
  "name": "gas-logger",
  "version": "1.3.1",
  "private": true,
  "description": "A structured logger for Google Apps Script that writes to the execution log and, optionally, to a Google Sheet.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-logger.git"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "prettier": "gas-dev-config/prettier",
  "gasDevConfig": {
    "loadOrder": [
      "gas-logger.types.ts",
      "gas-logger.constants.ts",
      "gas-logger.class.ts"
    ],
    "peers": {
      "gas-lock": "^1.1.0"
    },
    "gasTest": {
      "scopes": [
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/script.storage"
      ]
    }
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.11",
    "@types/node": "^22.20.5",
    "eslint": "^10.7.0",
    "gas-dev-config": "github:yorsh-co/gas-dev-config#semver:^1.4.0",
    "gas-dev-release": "github:yorsh-co/gas-dev-release#semver:^1.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "clean": "rimraf dist",
    "release": "gas-dev-release",
    "build": "npm run clean && tsc",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:watch": "tsc --watch",
    "build:release": "npm run build:format && npm run release",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p gas-test/tsconfig.json --noEmit && echo '✓ TypeScript passed'",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && gas-dev-config check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gas:build": "gas-dev-config gas-test build",
    "test:gas": "gas-dev-config gas-test run"
  }
}
